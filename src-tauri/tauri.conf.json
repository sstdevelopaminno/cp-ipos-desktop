{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CpIPOS Desktop",
  "version": "0.2.0",
  "identifier": "th.co.cuttingpoint.cpipos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CpIPOS Desktop",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "CpIPOS Desktop",
        "url": "splash.html",
        "width": 520,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost http://localhost:* ws://localhost:* https:"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:cpipos.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
